# Public application origins used for local development and generated links.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8787
# Browser-safe API origin. Set this for deployed web builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Comma-separated browser origins allowed to call the public API.
CORS_ORIGINS=http://localhost:3000

# API listener port. This is not a credential.
PORT=8787

# Server-only PostgreSQL connection string for the local `roavia` database.
DATABASE_URL=postgresql://roavia:roavia_dev@127.0.0.1:5432/roavia

# Local-only disposable database used by migration integration tests.
TEST_DATABASE_URL=postgresql://roavia_test:roavia_test@127.0.0.1:55432/roavia_test

# Supabase Auth. The URL and publishable key are safe browser configuration;
# never expose a Supabase secret or service-role key through NEXT_PUBLIC_*.
AUTH_PROVIDER=supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only AI provider selection and credential.
AI_PROVIDER=
AI_API_KEY=

# Server-only map, permanent/temporary geocoding, and routing provider.
# WDL-59 supports `mapbox`; tests use recorded fixtures and never consume this key.
MAPS_PROVIDER=mapbox
MAPS_API_KEY=

# Server-only weather provider selection and credential.
WEATHER_PROVIDER=
WEATHER_API_KEY=

# Server-only destination and practical travel-data provider configuration.
TRAVEL_DATA_PROVIDER=
TRAVEL_DATA_API_KEY=
