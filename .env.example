# Public application origins used for local development and generated links.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8787
# Browser-safe API origin. Set this for deployed web builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# Comma-separated browser origins allowed to call the public API.
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies that append X-Forwarded-For. Keep 0 for
# direct/local traffic; use 1 for the single Render edge proxy.
TRUSTED_PROXY_HOPS=0

# API listener port. This is not a credential.
PORT=8787

# Privacy-safe operational telemetry. Raw logs/traces may retain at most 30 days;
# aggregated metrics may retain at most 395 days by default. The metrics token is
# server-only and protects GET /internal/metrics when configured.
OBSERVABILITY_RAW_RETENTION_DAYS=30
OBSERVABILITY_AGGREGATED_RETENTION_DAYS=395
OBSERVABILITY_METRICS_TOKEN=

# Server-only PostgreSQL connection string for the local `roavia` database.
DATABASE_URL=postgresql://roavia:roavia_dev@127.0.0.1:5432/roavia

# Local-only disposable database used by migration integration tests.
TEST_DATABASE_URL=postgresql://roavia_test:roavia_test@127.0.0.1:55432/roavia_test

# Supabase Auth. The URL and publishable key are safe browser configuration;
# never expose a Supabase secret or service-role key through NEXT_PUBLIC_*.
AUTH_PROVIDER=supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only auth administration and account lifecycle secrets. Configure
# Supabase access-token expiry to 15 minutes or less. Never use NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_LIFECYCLE_SECRET=

# Server-only AI provider selection and credential.
AI_PROVIDER=vercel-gateway
AI_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
# Current model pricing used only for server-side estimated cost telemetry.
# Configure both values together in USD per one million tokens.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=

# Server-only map, permanent/temporary geocoding, and routing provider.
# WDL-59 supports `mapbox`; tests use recorded fixtures and never consume this key.
MAPS_PROVIDER=mapbox
MAPS_API_KEY=

# Server-only weather/climate provider selection and credential.
# WDL-61 supports the paid Open-Meteo customer endpoints. Do not enable a
# production key until the retention, commercial terms, and budget gates in the
# provider matrix are approved.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Server-only holiday provider. Calendarific remains opt-in pending written
# caching and redistribution rights; adapter results are not persisted.
HOLIDAY_PROVIDER=calendarific
HOLIDAY_API_KEY=

# Official advisory ingestion is scoped to GOV.UK guidance for GB travelers.
# Other nationality/residency contexts return unavailable.
ADVISORY_PROVIDER=govuk

# No-key ECB daily reference-rate provider for planning estimates only.
CURRENCY_PROVIDER=ecb

# Server-only destination and practical travel-data provider configuration.
TRAVEL_DATA_PROVIDER=
TRAVEL_DATA_API_KEY=
