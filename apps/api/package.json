{
  "name": "@roavia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Roavia Hono API runtime and server-side integration boundary.",
  "scripts": {
    "build": "tsc --noEmit false --outDir dist --rootDir src",
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint src --deny-warnings",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "hono": "4.12.32"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "tsx": "4.20.6"
  }
}
