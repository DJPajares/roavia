{
  "name": "@roavia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Roavia Hono API runtime and server-side integration boundary.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint src test --deny-warnings",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@roavia/contracts": "workspace:*",
    "@roavia/db": "workspace:*",
    "hono": "4.12.32",
    "jose": "6.2.4"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "tsx": "4.20.6"
  }
}
