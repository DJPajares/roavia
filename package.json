{
  "name": "roavia",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted travel planning and destination intelligence platform.",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "check": "turbo run lint typecheck test build",
    "check:affected": "turbo run lint typecheck test build --affected",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@roavia/web",
    "dev:api": "turbo run dev --filter=@roavia/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "precommit": "lint-staged",
    "prepare": "husky",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --affected"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "turbo": "2.10.6",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix --deny-warnings",
      "prettier --write"
    ],
    "*.{css,json,jsonc,md,yaml,yml}": "prettier --write"
  }
}
