{
  "name": "roavia",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted travel planning and destination intelligence platform.",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "ai:evaluate": "pnpm --filter @roavia/ai evaluate",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "check": "turbo run lint typecheck test build",
    "check:affected": "turbo run lint typecheck test build --affected",
    "db:generate": "pnpm --filter @roavia/db db:generate",
    "db:migrate": "pnpm --filter @roavia/db db:migrate",
    "db:reset:test": "pnpm --filter @roavia/db db:reset:test",
    "db:seed:destinations": "pnpm --filter @roavia/db db:seed:destinations",
    "db:test": "pnpm db:test:up && TEST_DATABASE_URL=postgresql://roavia_test:roavia_test@127.0.0.1:55432/roavia_test pnpm db:reset:test && TEST_DATABASE_URL=postgresql://roavia_test:roavia_test@127.0.0.1:55432/roavia_test pnpm --filter @roavia/db test:db",
    "db:test:down": "docker compose --project-name roavia-db-test -f packages/db/compose.test.yml down --volumes",
    "db:test:up": "docker compose --project-name roavia-db-test -f packages/db/compose.test.yml up --detach --wait",
    "dev": "turbo run dev --filter=@roavia/web --filter=@roavia/api",
    "dev:web": "turbo run dev --filter=@roavia/web",
    "dev:api": "turbo run dev --filter=@roavia/api",
    "dev:worker": "turbo run dev --filter=@roavia/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jobs:test:db": "pnpm db:test:up && TEST_DATABASE_URL=postgresql://roavia_test:roavia_test@127.0.0.1:55432/roavia_test pnpm db:reset:test && TEST_DATABASE_URL=postgresql://roavia_test:roavia_test@127.0.0.1:55432/roavia_test pnpm --filter @roavia/jobs test:db",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "precommit": "lint-staged",
    "prepare": "husky",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --affected"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix --deny-warnings",
      "prettier --write"
    ],
    "*.{css,json,jsonc,md,yaml,yml}": "prettier --write"
  }
}
