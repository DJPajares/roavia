{
  "name": "@roavia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema, migration, seed, and repository boundary.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:bootstrap:production-roles": "node --import tsx scripts/bootstrap-production-roles.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:reset:test": "node --import tsx scripts/reset-test.ts",
    "db:seed:destinations": "node --import tsx scripts/seed-destinations.ts",
    "lint": "oxlint drizzle.config.ts scripts src test --deny-warnings",
    "test": "vitest run --no-file-parallelism",
    "test:db": "vitest run --no-file-parallelism test/*.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@roavia/contracts": "workspace:*",
    "@roavia/offline": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.6"
  }
}
